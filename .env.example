# Workspace backend — environment template (M2 slice).
# Copy to .env and fill values LOCALLY. Never commit the real .env.

# --- Product database (PostgreSQL via infra/docker-compose.yml) ------------
# Host port 5433 (5432 is frequently owned by other local Postgres installs;
# AEW_DB_PORT and this URL must point at the same port).
DATABASE_URL=postgresql+psycopg://aew:aew@localhost:5433/aew
AEW_DB_PORT=5433
POSTGRES_USER=aew
POSTGRES_PASSWORD=aew
POSTGRES_DB=aew
# Zero-setup fallback for quick local runs/tests (no Docker):
# DATABASE_URL=sqlite:///./aew-dev.db

# --- Zetaris (sponsor platform, runs in its own stack) ----------------------
# Direct REST API base, ending in /api/v1.0 (NOT the UI origin on :3000).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Numeric organisation id: Zetaris UI -> Management -> Organisation -> ID. Do not guess.
ZETARIS_ORG_ID=
# API key: Zetaris UI -> Management -> API Tokens. Shown once. Local .env only.
ZETARIS_API_KEY=
# Optional tuning (defaults are sane):
# ZETARIS_QUERY_TIMEOUT_SECONDS=30
# ZETARIS_DEFAULT_ROW_LIMIT=100
# ZETARIS_MAX_ROW_LIMIT=1000

# --- ENG-017 read-model publisher (operator-only, dry-run by default) --------
# The product DB *as seen from inside Zetaris containers*. DOCKER DESKTOP:
# host.docker.internal resolves to this Windows host. Uses the SELECT-only
# zetaris_ro role — never the aew superuser. Password required only for --apply.
ZETARIS_READMODEL_HOST=host.docker.internal
ZETARIS_READMODEL_PORT=5433
ZETARIS_READMODEL_DATABASE=aew
ZETARIS_READMODEL_USER=zetaris_ro
ZETARIS_READMODEL_PASSWORD="your-zetaris_ro-password"

# --- Meterless Nightshift (M3: primary model runtime, runs on the Mac mini) --
# OpenAI-compatible base URL of the Nightshift host as seen from THIS machine
# (its LAN address in hotspot mode, not localhost). Setup guide:
# backend/docs/providers/nightshift-setup.md
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Runtime API key: Nightshift Console > API key (the Mac M1-M4 app also keeps
# it in its state directory as runtime-token). Never the hotspot connect link.
# Local .env only; the placeholder rt-local is rejected.
NIGHTSHIFT_TOKEN=
# Optional (defaults are sane):
# NIGHTSHIFT_APP_ID=agentic-engineering-workspace
# NIGHTSHIFT_TIMEOUT_SECONDS=180
# NIGHTSHIFT_CONNECT_TIMEOUT_SECONDS=5

# --- ModelGateway (M3, ENG-008): capability -> lane routing, all optional ----
# Lanes are routing modes; pin a model id (e.g. Nemotron) per capability here.
# MODEL_GATEWAY_DEFAULT_LANE=meterless/auto
# MODEL_GATEWAY_LANES={"requirements.analyze_input": "nvidia/nemotron-3.5-lightning-30b-a3b"}
# MODEL_GATEWAY_MAX_TOKENS=4096

# --- Meterless H-MEM engine (M3, ENG-018): project memory sidecar ------------
# hmem-service from infra/docker-compose.yml. No credentials. Contracts that
# recall memory (architecture.design_change) fail closed with 503 without it.
HMEM_BASE_URL=http://127.0.0.1:8099
# Optional (defaults are sane):
# HMEM_PORT=8099
# HMEM_TIMEOUT_SECONDS=5
# HMEM_RECALL_TOP_N=5
# HMEM_RECALL_THRESHOLD=0.35

# --- GitHub (M5: demo-target repo access, ENG-005/010/040) -----------------
# Fine-grained personal access token limited to the DEMO repo only
# (Repository access: only select repositories -> the demo repo;
# permissions: Contents read/write, Pull requests read/write, Metadata read).
# Never a classic token with `repo` scope. Local .env only.
GITHUB_TOKEN=
# Throwaway repo the agent is allowed to change. Must differ from the product repo.
GITHUB_DEMO_REPO=
# This product's repo; the preflight proves the token cannot write it.
GITHUB_PRODUCT_REPO=tekeufranck681/agentic-engineering-workspace

# --- E2B sandbox (M5: isolated execution, ENG-005/015) ----------------------
# API key from the E2B dashboard. Local .env only.
E2B_API_KEY=
# Optional:
# E2B_TEMPLATE=
# E2B_TIMEOUT_SECONDS=300
# E2B_COMMAND_TIMEOUT_SECONDS=120
